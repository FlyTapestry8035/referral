# Copy to .env.local for local development. Never commit real values.

# Supabase (Project Settings → API). For local dev, `npx supabase status` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com → API Keys). Leave empty locally: emails are printed to the server console instead.
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend. onboarding@resend.dev only delivers to your own Resend account email.
EMAIL_FROM=Referral <onboarding@resend.dev>

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>". Generate with: openssl rand -hex 24
CRON_SECRET=
# Signs feedback/unsubscribe links in emails (HMAC-SHA256). Generate with: openssl rand -hex 32
TOKEN_SECRET=

# Public base URL used in emails and links, no trailing slash.
APP_URL=http://localhost:3000

# Optional: shared rate limiting in production (upstash.com). Without these, an in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: "daily" (default, Vercel Hobby) or "hourly" (if vercel.json runs the digest cron every hour; Pro plan).
DIGEST_CRON_MODE=daily
